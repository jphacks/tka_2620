# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by scripts/ (seed, demo reset). Never import in app code.
SUPABASE_SERVICE_ROLE_KEY=
# Set a monthly spending cap in the Claude Console before using this key.
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-4-5-20251001
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3
# Shared password for the five demo users (a24, a25, a26, b, x)
DEMO_PASSWORD=
# 1 = screens use lib/mocks.ts instead of the API (screens and content lanes, until the engine endpoint lands)
NEXT_PUBLIC_USE_MOCKS=0
# Upload limits for 「＋ 追加」 (files are read in the browser and never uploaded)
NEXT_PUBLIC_MAX_UPLOAD_MB=10
NEXT_PUBLIC_MAX_PDF_PAGES=30

CONSOLE_SIGN_IN=
